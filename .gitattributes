# Normalize line endings; let git detect text versus binary automatically.
* text=auto

# Shell scripts and makefiles must stay LF: they are run on Linux build hosts, and
# CRLF makes a script fail with a confusing 'bad interpreter' error.
*.sh        text eol=lf
*.bash      text eol=lf
Makefile    text eol=lf

# Known-binary assets. Without these, end-of-line conversion corrupts test fixtures.
*.lib       binary
*.dll       binary
*.a         binary
*.o         binary
*.png       binary
*.pdf       binary
*.bin       binary
*.raw       binary

# Hooks are shell scripts without an extension, so name them explicitly. CRLF here makes
# git refuse to run them with a "bad interpreter" error.
Scripts/hooks/*     text eol=lf

# Vendored driver ABI headers are stored byte-for-byte as they came from the SDK, CRLF
# included. Normalising them would make a diff against the SDK copy show every line as
# changed, which is exactly the property that keeps a future ABI refresh a copy.
Source/DtPcie/Abi/**   -text
