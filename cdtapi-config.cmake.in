@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The library links the platform's threads library, and says so in its interface, so a
# consumer's project must find it before the target can be loaded.
if(NOT WIN32)
    find_dependency(Threads)
endif()

# A library built with the NMOS bridge links dtnmos, and says so in its interface.
set(CDTAPI_WITH_NMOS @CDTAPI_WITH_NMOS@)
if(CDTAPI_WITH_NMOS)
    find_dependency(dtnmos 0.5 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cdtapi-targets.cmake")

check_required_components(cdtapi)
