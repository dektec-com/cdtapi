## cdtapiConfig.cmake - package configuration file

## Get the CMAKE directory
get_filename_component(CDTAPI_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

include(CMakeFindDependencyMacro)
@PACKAGE_INIT@

if(NOT TARGET cdtapi::cdtapi)
    message(STATUS "CDTAPI: adding as imported target")
    include("${CDTAPI_CMAKE_DIR}/cdtapiTargets.cmake")
endif()

