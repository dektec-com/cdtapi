//
// CDtapiLite - Every I/O configuration code, in numeric order, as an X-macro list
//
// SPDX-License-Identifier: BSD-3-Clause
//
// Each entry is the DTAPI_IOCONFIG_ macro name without its prefix. Including this file
// with X defined expands the list, so that the name string and the numeric code of an
// entry come from one token and cannot disagree:
//
//     #define X(Name) { #Name, DTAPI_IOCONFIG_##Name },
//     #include "Tables/DtlIoConfigList.inc"
//     #undef X
//
// The order is numeric so that the table can be indexed by code. A unit test checks
// that every code from zero upwards appears exactly once, so a new constant added to
// CDtapiLite.h without an entry here fails that test rather than going unnoticed.
//
// No include guard: the file is meant to be included more than once.

