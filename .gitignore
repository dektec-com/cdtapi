# .-.-.- Build output -.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.
# Build/ is the binaryDir used by every CMake preset; out/ is what Visual Studio's
# "Open Folder" mode uses when it configures CMake on its own.
Build/
out/
Export/
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/

# .-.-.- Visual Studio / MSBuild user state -.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-
.vs/
*.user
*.pdb
*.ilk
*.tlog
*.opendb
*.VC.db
*.obj

# .-.-.- Generated at configure time from Include/cdtapi_version.h.in -.-.-.-.-.-.-.-
Include/cdtapi_version.h

# .-.-.- Surround SCM bookkeeping -.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-
# CDTAPI lives in git, not in Surround. These patterns keep Surround's metadata out
# of the repository should the directory ever be placed under Surround as well.
.MySCMServerInfo
*.vssscc
*.vspscc

# .-.-.- Editor and OS clutter -.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.
__pycache__/
.vscode/
*.swp
Thumbs.db
.DS_Store

# .-.-.- The design documents -.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.
# They live in dektec-com/cdtapi-design; see CONTRIBUTING.md.
Documentation/

# .-.-.- What the tests write -.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.
# A suite run from the source directory rather than the build directory leaves its frame
# files there. They are megabytes of generated pattern and are made again every run.
*.sdi
*.raw

# .-.-.- Internal notes -.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.-.
# Notes for DekTec's own tooling. They name internal machines and repositories, so they
# stay out of the published sources; Scripts/check_style.sh refuses them as well.
CLAUDE.md
CLAUDE.local.md
