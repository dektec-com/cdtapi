# Checks that formatting cannot catch. Coding rules 4 and 6 are handled by
# .clang-format; rule 5 and the "no historical comments" half of rule 2 are handled
# by Scripts/check_style.sh, which runs in the same gate.
---
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-braces-around-statements,
  -bugprone-easily-swappable-parameters

WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(Source|Include|Tests)/.*\.h$'
FormatStyle: file
